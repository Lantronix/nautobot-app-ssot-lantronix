# Copy to .env in this directory and fill in every value.
# Generate the secret key and passwords with: openssl rand -hex 32
NAUTOBOT_SECRET_KEY=
NAUTOBOT_DB_PASSWORD=
NAUTOBOT_SUPERUSER_PASSWORD=
# 40 hexadecimal characters: openssl rand -hex 20
NAUTOBOT_SUPERUSER_API_TOKEN=

# The Percepxion user needs the tenant_user role in the organization you sync.
PERCEPXION_URL=https://api.percepxion.ai/api
PERCEPXION_USERNAME=
PERCEPXION_PASSWORD=
PERCEPXION_ORG_ID=
